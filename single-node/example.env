# Copy this file to a host-local env file such as:
#   single-node/.env.staging
#   single-node/.env.production
#
# Do not put real secrets in this tracked example file.

# These are beta 4 indexer internal service users.
# Start the stack once with these stock values. After the containers are
# healthy, use the password change procedure in docs/setup.md, then replace
# these values with the matching host-specific passwords.

MANAGER_INDEXER_USERNAME=wazuh-manager
MANAGER_INDEXER_PASSWORD=wazuh-manager

DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=kibanaserver
